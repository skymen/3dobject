              "mesh-name": {
                "name": "Node name",
                "desc": "Node name to set material to."
              },
              "material-name": {
                "name": "Material name",
                "desc": "Material name (existing or the material name used when loading)."
              }
            }
          },
          "enable-node": {
            "list-name": "Enable node",
            "display-text": "Set node [i]{0}[/i] enable to [i]{1}[/i]",
