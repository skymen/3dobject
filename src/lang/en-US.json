            "params": {
              "gltf-path": {
                "name": "Gltf path",
                "desc": "Gltf/glb project file name or URL to Gltf/glb file (with URL, it will not show in the editor)."
              }
            }
          },
          "load-material": {
            "list-name": "Load material",
            "display-text": "Load material [i]{1}[/i] from [i]{0}[/i]",
